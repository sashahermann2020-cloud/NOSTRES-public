{
  "name": "nostres",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "start": "vinext start",
    "test": "npm run build && node --import ./scripts/node-stubs/register-cloudflare-stub.mjs --test tests/*.test.mjs",
    "test:a11y": "eslint app --ignore-pattern dist --ignore-pattern .next",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "build:cloudflare": "bash scripts/build-cloudflare.sh",
    "test:cloudflare": "npm test && npm run build:cloudflare",
    "typecheck": "wrangler types worker-configuration.d.ts --include-env=false && tsc --noEmit -p .",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.3.8",
    "wrangler": "4.161.0"
  },
  "type": "module",
  "displayName": "NOSTRES"
}
